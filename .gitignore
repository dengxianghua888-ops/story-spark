# ============================================================
# 第三方爆款原文版权保护 — 不得分发
# ============================================================

# corpus 所有 source.md(第三方爆款原文)
corpus/*/source.md

# stories 所有 source.md(具体仿写项目的原文输入)
stories/*/source.md

# 原文的任何改名副本/备份/原始导入(如 source.original-*.md、*.txt)同样不得入库。
# tests/test_repository_hygiene.py 会在 CI 中检查已跟踪文件。
corpus/**/[Ss]ource*.md
corpus/**/[Ss]ource*.md[.~]*
corpus/**/原文*
corpus/**/*.txt
stories/**/[Ss]ource*.md
stories/**/[Ss]ource*.md[.~]*
stories/**/原文*
stories/**/*.txt
# 工具写入的原文损坏说明，不是原文本身。
!**/SOURCE_CORRUPT.md

# ============================================================
# 运行时产物 / 日志
# ============================================================

# pipeline.sh 每次跑批日志
runs/
corpus/*/runs/
stories/*/runs/
stories/*/pipeline.log
batch.log

# 返工备份
stories/*/draft-v*.md

# ============================================================
# Python / 编辑器 / 系统
# ============================================================

__pycache__/
*.pyc
*.pyo
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================
# 本地临时
# ============================================================
.env
.env.local
*.log
tmp/
scratch/

# ============================================================
# Claude Code 本地配置(用户机器特定)
# ============================================================
.claude/

# 本地 AI / IDE 工具状态
.comate/
.context/

# Local transaction candidates/backups retain private story inputs.
.*.attempt-*/
.*.storyforge.lock
.*.picker-*/
